# Application Settings
PROJECT_NAME="VirasatAI Spatial Engine"
API_V1_STR="/api/v1"
DEBUG=true

# Database Settings (PostgreSQL with PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=virasatai

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8088","https://virasa-ai.vercel.app"]
